  "2": 23
  "3": 23
  "4": 23
  "5": 23
  "6": 23
  "7": 23
  "8": 23
  "9": 23

# To schedule CI on different days of the month, this is a map that relates a letter to a minute of the hour.
letter_minute_mapping:
  a: 1
  b: 3
  c: 5
  d: 7
  e: 9
  f: 11
  g: 13
  h: 15
  i: 17
  j: 19
  k: 21
