---
{{ ansible_managed | comment }}

name: Ansible Molecule

on:
  push:
    branches:
      - master
      - main
  pull_request:
    branches:
      - master
      - main
  schedule:
    - cron: '{{ letter_minute_mapping[role_name[0]] }} {{ letter_hour_mapping[role_name[0]] }} {{ letter_day_mapping[role_name[0]] }} * *'

  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.ref }}{% endraw %}-{% raw %}${{ github.workflow }}{% endraw %}

  cancel-in-progress: true

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - name: checkout
        uses: actions/checkout@v6
      - name: ansible-lint
        uses: ansible/ansible-lint@v26.2.0

  molecule:
    needs:
      - lint
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        distro:
{% set matrix = namespace(seen=[]) %}
{% for platform in meta.galaxy_info.platforms %}
{% set platform_key = platform_name_alias_mapping.get(platform.name, platform.name) %}
{% set image = platform_image_mapping.get(platform_key, default_matrix_image) %}
{% set version_map = distribution_version_mapping.get(platform_key, {}) %}
{% set fallback_tags = version_map.get('all', [default_matrix_tag]) %}
{% for version in platform.versions %}
{% set version_key = distribution_version_alias_mapping.get(version | string, version | string) %}
{% set tags = version_map.get(version_key, fallback_tags) %}
{% for tag in tags %}
{% set matrix_key = image ~ '|' ~ tag %}
{% if matrix_key not in matrix.seen %}
          - image: "{{ image }}"
            tag: "{{ tag }}"
{% set _ = matrix.seen.append(matrix_key) %}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{% if molecule_matrix_include is defined %}
{% for item in molecule_matrix_include %}
{% set image = item.image | default(default_matrix_image) %}
{% set tag = item.tag | default(default_matrix_tag) %}
{% set matrix_key = image ~ '|' ~ tag %}
{% if matrix_key not in matrix.seen %}
          - image: "{{ image }}"
            tag: "{{ tag }}"
{% set _ = matrix.seen.append(matrix_key) %}
{% endif %}
{% endfor %}
{% endif %}
    steps:
      - name: checkout
        uses: actions/checkout@v6
        with:
          path: ansible-role-{{ role_name }}

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.13"

      - name: Configure Docker for systemd
        run: |
          sudo mkdir -p /etc/docker
          echo '{
            "features": {
              "buildkit": true
            },
            "exec-opts": ["native.cgroupdriver=systemd"]
          }' | sudo tee /etc/docker/daemon.json
          sudo systemctl restart docker || true

      - name: Install Docker
        uses: docker/setup-buildx-action@v3

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip3 install ansible molecule molecule-plugins[docker] docker

      - name: Test with molecule
        run: |
          cd ansible-role-{{ role_name }}
          molecule test
        env:
          PY_COLORS: 1
          ANSIBLE_FORCE_COLOR: 1
          ANSIBLE_ROLES_PATH: ~/.ansible/roles:${GITHUB_WORKSPACE}/ansible-role-{{ role_name }}
          image: {% raw %}${{ matrix.distro.image }}{% endraw %}

          tag: {% raw %}${{ matrix.distro.tag }}{% endraw %}
