---

variables:
  DEBIAN_FRONTEND: noninteractive

molecule:
  image: python:3.13
  script:
    - apt-get update -qq
    - apt-get -y -qq install yamllint docker.io
    - mkdir -p /etc/docker
    - echo '{"features":{"buildkit":true},"exec-opts":["native.cgroupdriver=systemd"]}' > /etc/docker/daemon.json
    - service docker restart || true
    - python -m pip install --upgrade pip
    - pip3 install ansible molecule molecule-plugins[docker] docker
    - cd $CI_PROJECT_DIR
    - molecule test
  rules:
    - if: $CI_COMMIT_REF_NAME == "master"
  parallel:
    matrix:
{% set matrix = namespace(entries=molecule_platform_matrix | default([]), seen=[]) %}
{% for item in molecule_matrix_include | default([]) %}
{% set image = item.image | default(default_matrix_image | default(fallback_matrix_image | default('docker-molecule-images'))) %}
{% set tag = item.tag | default(default_matrix_tag | default('latest')) %}
{% set matrix.entries = matrix.entries + [[image, tag]] %}
{% endfor %}
{% for image, tag in matrix.entries %}
{% if [image, tag] not in matrix.seen %}
      - image: "{{ image }}"
        tag: "{{ tag }}"
{% set matrix.seen = matrix.seen + [[image, tag]] %}
{% endif %}
{% endfor %}

galaxy:
  image: python:3.13
  script:
    - apt-get update -qq
    - apt-get -y -qq install ansible-core
    - ansible-galaxy role import --api-key ${GALAXY_API_KEY} {{ galaxy_namespace }} ${CI_PROJECT_NAME}
  rules:
    - if: $CI_COMMIT_TAG != null
