---

variables:
  DEBIAN_FRONTEND: noninteractive

molecule:
  image: python:3.13
  script:
    - apt-get update -qq
    - apt-get -y -qq install yamllint docker.io
    - mkdir -p /etc/docker
    - echo '{"features":{"buildkit":true},"exec-opts":["native.cgroupdriver=systemd"]}' > /etc/docker/daemon.json
    - service docker restart || true
    - python -m pip install --upgrade pip
    - pip3 install ansible molecule molecule-plugins[docker] docker
    - cd $CI_PROJECT_DIR
    - molecule test
  rules:
    - if: $CI_COMMIT_REF_NAME == "master"
  parallel:
    matrix:
{% set matrix = namespace(seen=[]) %}
{% for platform in meta.galaxy_info.platforms %}
{% set platform_key = platform_name_alias_mapping.get(platform.name, platform.name) %}
{% set image = platform_image_mapping.get(platform_key, default_matrix_image) %}
{% set version_map = distribution_version_mapping.get(platform_key, {}) %}
{% set fallback_tags = version_map.get('all', [default_matrix_tag]) %}
{% for version in platform.versions %}
{% set version_key = distribution_version_alias_mapping.get(version | string, version | string) %}
{% set tags = version_map.get(version_key, fallback_tags) %}
{% for tag in tags %}
{% set matrix_key = image ~ '|' ~ tag %}
{% if matrix_key not in matrix.seen %}
      - image: "{{ image }}"
        tag: "{{ tag }}"
{% set _ = matrix.seen.append(matrix_key) %}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{% if molecule_matrix_include is defined %}
{% for item in molecule_matrix_include %}
{% set image = item.image | default(default_matrix_image) %}
{% set tag = item.tag | default(default_matrix_tag) %}
{% set matrix_key = image ~ '|' ~ tag %}
{% if matrix_key not in matrix.seen %}
      - image: "{{ image }}"
        tag: "{{ tag }}"
{% set _ = matrix.seen.append(matrix_key) %}
{% endif %}
{% endfor %}
{% endif %}

galaxy:
  image: python:3.13
  script:
    - apt-get update -qq
    - apt-get -y -qq install ansible-core
    - ansible-galaxy role import --api-key ${GALAXY_API_KEY} {{ galaxy_namespace }} ${CI_PROJECT_NAME}
  rules:
    - if: $CI_COMMIT_TAG != null
